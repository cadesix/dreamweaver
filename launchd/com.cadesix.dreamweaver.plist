<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Filled in by scripts/install.sh: __NODE__, __REPO__, __LOG__, __PATH__. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.cadesix.dreamweaver</string>
	<key>ProgramArguments</key>
	<array>
		<string>__NODE__</string>
		<string>__REPO__/server/server.mjs</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__REPO__</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>__PATH__</string>
	</dict>
	<!-- Up at login, and back within seconds if it ever exits. -->
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardOutPath</key>
	<string>__LOG__</string>
	<key>StandardErrorPath</key>
	<string>__LOG__</string>
</dict>
</plist>
